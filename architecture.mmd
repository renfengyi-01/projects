%% chat-stream-tool-fileOps.py 代码架构图 (Mermaid)
%% 由项目源码直接映射生成
flowchart TD
    subgraph ENTRY["入口层"]
        main["main()<br/>解析命令行参数<br/>初始化各组件"]
    end

    subgraph UI["界面层 (REPL)"]
        repl["repl()<br/>命令行交互循环<br/>/exit /tools 指令"]
    end

    subgraph SESSION["会话层"]
        ChatSession["ChatSession<br/>维护消息历史<br/>驱动 模型↔工具 循环<br/>max_tool_rounds 上限"]
    end

    subgraph CLIENT["客户端层"]
        LLMClient["LLMClient<br/>OpenAI 兼容接口<br/>SSE 流式增量解析<br/>tool_calls 增量拼装"]
    end

    subgraph TOOLS["工具层 (fileOps)"]
        FileOps["FileOps<br/>文件操作工具集<br/>路径穿越防护"]
        schemas["tool_schemas()<br/>Function Calling Schema<br/>6 个工具定义"]
    end

    subgraph EXT["外部依赖"]
        API["大模型 API<br/>/chat/completions<br/>stream=true"]
        FS[("文件系统<br/>工作目录")]
    end

    main --> repl
    repl --> ChatSession
    ChatSession --> LLMClient
    ChatSession --> FileOps
    LLMClient --> API
    FileOps --> FS
    schemas --> LLMClient
    FileOps -. "读取/写入/删除" .-> FS

    classDef entry fill:#eef2ff,stroke:#6366f1,color:#312e81
    classDef ui fill:#ecfdf5,stroke:#10b981,color:#064e3b
    classDef session fill:#fffbeb,stroke:#f59e0b,color:#78350f
    classDef client fill:#fef2f2,stroke:#ef4444,color:#7f1d1d
    classDef tools fill:#f5f3ff,stroke:#8b5cf6,color:#4c1d95
    classDef ext fill:#f8fafc,stroke:#94a3b8,color:#1e293b
    class main entry
    class repl ui
    class ChatSession session
    class LLMClient client
    class FileOps,schemas tools
    class API,FS ext
